# Do not run an implicit `pnpm install` before every `pnpm run` script. The
# recursive script gates (typecheck/build/test) must not fail merely because a
# dependency-status check wants to re-verify the store on Windows.
verify-deps-before-run=false

# esbuild's prebuilt binaries are installed as optional deps; its build script is
# not needed, but whitelist it so ignored-build-scripts is not treated as fatal.
enable-pre-post-scripts=true
